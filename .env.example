# n8n workflow environment template

# n8n runtime
N8N_HOST=localhost
N8N_PORT=5678
N8N_PROTOCOL=http
N8N_WEBHOOK_URL=http://localhost:5678

# AI provider
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# Optional alternate provider config
ANTHROPIC_API_KEY=

# Email / notifications
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@example.com

# Storage / databases
DATABASE_URL=
APPLICATIONS_DB_PATH=./data/applications.db

# Automation webhooks
JOB_APP_WEBHOOK_URL=
DAILY_RUN_WEBHOOK_URL=
WEEKLY_SUMMARY_WEBHOOK_URL=

# Application / job tracking
JOB_TRACKER_API_KEY=
JOB_TRACKER_BASE_URL=

# Optional security / advanced config
N8N_ENCRYPTION_KEY=
N8N_SECURE_COOKIE=false
